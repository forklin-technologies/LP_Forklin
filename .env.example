# Formulários de contato (Fale conosco e B2B) — envio via Resend.
# Configure no Dokploy (variáveis de ambiente do serviço), nunca no código.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Opcionais (valores padrão entre parênteses):
# Destino dos contatos (contato@forklin.com.br)
LEAD_TO_EMAIL=contato@forklin.com.br
# Remetente — o domínio precisa estar verificado no Resend (Site Forklin <site@forklin.com.br>)
LEAD_FROM_EMAIL=Site Forklin <site@forklin.com.br>
